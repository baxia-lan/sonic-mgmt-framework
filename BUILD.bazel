"""sonic-mgmt-framework Debian packages — migrated from rules/sonic-mgmt-framework.mk."""

load("//rules/bazel/deb:deb.bzl", "deb_package_set")

package(default_visibility = ["//visibility:public"])

deb_package_set(
    name = "mgmt_framework_debs",
    srcs = glob(
        ["**/*"],
        exclude = [
            ".git/**",
            "BUILD.bazel",
        ],
    ),
    build_deps = [
        "//src/sonic-mgmt-common:mgmt_common",
        "//src/sonic-mgmt-common:mgmt_common_codegen",
    ],
    debian_dir = "debian",
    declared_outputs = [
        "sonic-mgmt-framework_1.0-01_$(ARCH).deb",
    ],
    version = "1.0-01",
    visibility = ["//visibility:public"],
)
